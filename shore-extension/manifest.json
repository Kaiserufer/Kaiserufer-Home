{
  "manifest_version": 3,
  "name": "Kaiserufer Shore Tag Sync",
  "version": "1.0.0",
  "description": "Synchronisiert Kunden-Tags von Shore nach Kaiserufer Home",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://app.shore.com/*",
    "https://my.shore.com/*",
    "https://*.shore.com/*",
    "https://oqjcbxnbododdqlbdekt.supabase.co/*",
    "https://home.kaiserufer.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.shore.com/*", "https://my.shore.com/*", "https://*.shore.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
